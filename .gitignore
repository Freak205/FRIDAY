# Python
__pycache__/
*.py[cod]
*.egg-info/
.Python

# Virtual environments
.venv/
venv/
env/

# Environment / secrets
.env
.env.*
*.pem
*.key

# FRIDAY runtime data (everything FRIDAY writes at run time: models, cache,
# logs, sqlite db, browser profile, live-run/benchmark reports)
data/

# Claude Code local runtime state
.claude/scheduled_tasks.lock

# OS
Thumbs.db
.DS_Store

# Editors
.vscode/
.idea/

# Benchmark runs (Phase 29+): only the reproducible JSON baselines are kept. Logs, interim
# runs and scratch outputs embed machine-specific paths and are not committed.
benchmarks/*.log
benchmarks/*interim*
benchmarks/mine.json
benchmarks/new.json
benchmarks/*.tmp

# Database scrub backups / disposable restore copies (they hold plaintext history)
FRIDAY-backups/
*.db.bak
